// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ─── ADMIN ────────────────────────────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  otpTokens      OtpToken[]
  refreshTokens  RefreshToken[]

  @@map("admin")
}

// ─── OTP TOKEN ────────────────────────────────────────────────────────────────

model OtpToken {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  codeHash  String   @map("code_hash")   // bcrypt hash of 6-digit OTP
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("otp_token")
}

// ─── REFRESH TOKEN ───────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  tokenHash String    @map("token_hash")  // sha256 hash of the actual token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

enum SkillMode {
  code
  terminal
}

model Skill {
  id         String    @id @default(cuid())
  name       String    @unique
  icon       String
  file_name  String
  lang       String
  color      String
  mode       SkillMode
  code       Json?     // String[]        — present only when mode = code
  commands   Json?     // TerminalLine[]  — present only when mode = terminal
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Portfolio_item {
  id             String   @id @default(uuid())
  site_name      String
  site_role      String
  site_url       String @db.VarChar(500)
  site_image_url String @db.VarChar(500)
  use_tech       Json
  description    String @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
 
  @@map("portfolio_items")
}

model ContactMessage {
  id         String   @id @default(cuid())
  full_name  String
  email      String
  message    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
 
  @@map("contact_messages")
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model Visitor {
  id          String   @id @default(cuid())
  anonymousId String   @unique @map("anonymous_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  visitCount  Int      @default(1) @map("visit_count")

  sessions Session[]

  @@map("visitor")
}

model Session {
  id           String    @id @default(cuid())
  visitorId    String    @map("visitor_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  endedAt      DateTime? @map("ended_at")
  landingPage  String?   @map("landing_page")
  exitPage     String?   @map("exit_page")
  referrer     String?
  country      String?
  region       String?
  city         String?
  deviceType   String?   @map("device_type")
  browser      String?
  os           String?
  screenWidth  Int?      @map("screen_width")
  screenHeight Int?      @map("screen_height")

  visitor   Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  pageViews PageView[]
  events    AnalyticsEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@map("session")
}

model PageView {
  id         String    @id @default(cuid())
  sessionId  String    @map("session_id")
  path       String
  title      String?
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMs Int?      @map("duration_ms")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([path])
  @@index([startedAt])
  @@map("page_view")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  type      String
  path      String?
  timestamp DateTime @default(now())
  metadata  Json?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
  @@map("analytics_event")
}

model AnalyticsDaily {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  visitors        Int      @default(0)
  sessions        Int      @default(0)
  pageViews       Int      @default(0) @map("page_views")
  contactOpens    Int      @default(0) @map("contact_opens")
  contactSubmits  Int      @default(0) @map("contact_submits")
  gameStarts      Int      @default(0) @map("game_starts")
  gameCompletions Int      @default(0) @map("game_completions")

  @@map("analytics_daily")
}

model AnalyticsProjectDaily {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  projectId    String   @map("project_id")
  views        Int      @default(0)
  demoClicks   Int      @default(0) @map("demo_clicks")
  githubClicks Int      @default(0) @map("github_clicks")

  @@unique([date, projectId])
  @@map("analytics_project_daily")
}